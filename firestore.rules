
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Private profile. Only the owner can read or write it.
    match /Users/{uid} {
      allow read, write: if signedIn()
        && request.auth.uid == uid;
    }

    // Private medical information. Only the owner can read or write it.
    match /MedicalInformation/{uid} {
      allow read, write: if signedIn()
        && request.auth.uid == uid;
    }

    // Private emergency contacts.
    match /EmergencyContacts/{contactId} {
      allow read: if signedIn()
        && resource.data.userId == request.auth.uid;

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;

      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;

      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    // QR sharing. Anyone with the exact token can read a shared card.
    match /SharedCards/{token} {
      allow get: if true;
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid;

      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid;

      allow delete: if signedIn()
        && resource.data.ownerId == request.auth.uid;
    }
  }
}
